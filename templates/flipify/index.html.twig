{% extends 'base.html.twig' %}

{% block title %}Flipify{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h1 class="mb-4 text-center">Flipify</h1>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}

            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted">Upload a PDF brochure to analyse its products. The company website field is optional.</p>
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.companyWebsite) }}
                            {{ form_widget(form.companyWebsite, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.companyWebsite) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.pdfFile) }}
                            {{ form_widget(form.pdfFile, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.pdfFile) }}
                        </div>
                        <div class="d-grid">
                            {{ form_widget(form.submit, {'attr': {'class': 'btn btn-primary btn-lg'}}) }}
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h4 mb-0">Analysed brochures</h2>
                        <span class="text-muted small">Total analyses: {{ imports|length }}</span>
                    </div>

                    <div class="table-responsive">
                        <table id="flipify-results" class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Uploaded at</th>
                                    <th scope="col">File</th>
                                    <th scope="col">Company website</th>
                                    <th scope="col">Detected products</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for import in imports %}
                                    <tr>
                                        <td data-order="{{ import.createdAt|date('U') }}">{{ import.createdAt|date('Y-m-d H:i') }}</td>
                                        <td>
                                            <div class="fw-semibold">{{ import.originalFilename }}</div>
                                            <div class="text-muted small">{{ import.productCount }} product{{ import.productCount == 1 ? '' : 's' }}</div>
                                        </td>
                                        <td>
                                            {% if import.companyWebsite %}
                                                <a href="{{ import.companyWebsite }}" target="_blank" rel="noopener noreferrer">{{ import.companyWebsite }}</a>
                                            {% else %}
                                                <span class="text-muted">—</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if import.products is empty %}
                                                <span class="text-muted">No products detected.</span>
                                            {% else %}
                                                <div class="flipify-product-list">
                                                    {% for product in import.products %}
                                                        <div class="border-start border-3 border-primary ps-3 mb-3">
                                                            <div class="fw-semibold">{{ product.name ?? 'Unknown product' }}</div>
                                                            <ul class="list-unstyled mb-2 small">
                                                                <li><strong>Page:</strong> {{ product.page ?? '—' }}</li>
                                                                {% if product.position is defined and product.position is not null %}
                                                                    <li><strong>Position:</strong> {{ product.position }}</li>
                                                                {% endif %}
                                                                {% if product.category %}
                                                                    <li><strong>Category:</strong> {{ product.category }}</li>
                                                                {% endif %}
                                                                {% if product.price is not null %}
                                                                    <li>
                                                                        <strong>Price:</strong>
                                                                        {{ product.price|number_format(2, '.', ' ') }}{% if product.currency %} {{ product.currency }}{% endif %}
                                                                    </li>
                                                                {% endif %}
                                                                {% if product.discount_price is not null %}
                                                                    <li>
                                                                        <strong>Discount price:</strong>
                                                                        {{ product.discount_price|number_format(2, '.', ' ') }}{% if product.currency %} {{ product.currency }}{% endif %}
                                                                    </li>
                                                                {% endif %}
                                                                {% set box = product.bounding_box ?? {} %}
                                                                {% if (box.x ?? null) is not null or (box.y ?? null) is not null or (box.width ?? null) is not null or (box.height ?? null) is not null %}
                                                                    <li>
                                                                        <strong>Coordinates:</strong>
                                                                        x={{ box.x is not null ? box.x|number_format(1, '.', ' ') : '—' }},
                                                                        y={{ box.y is not null ? box.y|number_format(1, '.', ' ') : '—' }},
                                                                        w={{ box.width is not null ? box.width|number_format(1, '.', ' ') : '—' }},
                                                                        h={{ box.height is not null ? box.height|number_format(1, '.', ' ') : '—' }}
                                                                    </li>
                                                                {% endif %}
                                                            </ul>
                                                            {% if product.description %}
                                                                <p class="text-muted small mb-0">{{ product.description }}</p>
                                                            {% endif %}
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_flipify_export', {id: import.id}) }}">
                                                Export JSON
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if imports is empty %}
                        <p class="text-center text-muted mb-0 mt-3">No analyses yet. Upload a brochure to get started.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tableElement = document.getElementById('flipify-results');
            if (!tableElement || typeof window.jQuery === 'undefined') {
                return;
            }

            window.jQuery(tableElement).DataTable({
                order: [[0, 'desc']],
                pageLength: 10,
                language: {
                    search: 'Filter:',
                    info: 'Showing _START_ to _END_ of _TOTAL_ analyses',
                    infoEmpty: 'Showing 0 analyses',
                    lengthMenu: 'Show _MENU_ analyses',
                    zeroRecords: 'No analyses found',
                },
                columnDefs: [
                    { orderable: false, targets: [3, 4] },
                ],
            });
        });
    </script>
{% endblock %}
